# ---------------------------------------------------------------------------
# Banco de dados (Supabase Postgres)
# Em produção (Vercel), DATABASE_URL DEVE ser a connection string do pooler (porta 6543) com
# ?pgbouncer=true&connection_limit=1 — cada função serverless abre a própria conexão.
# DIRECT_URL (porta 5432) é usada só pelo Prisma CLI (db push / migrate).
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@aws-0-REGIAO.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://USER:PASSWORD@aws-0-REGIAO.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# Auth.js
# Gere um valor NOVO para produção:  openssl rand -base64 32
# Na Vercel não é preciso definir AUTH_URL (o host é detectado sozinho).
# ---------------------------------------------------------------------------
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ---------------------------------------------------------------------------
# Supabase Storage
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Chave secreta: só no servidor. Nunca com prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=""

# ---------------------------------------------------------------------------
# Site
# URL pública, sem barra no final. É embutida no build (NEXT_PUBLIC_): se mudar, faça novo deploy.
# Em produção: https://seudominio.com.br
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# E-mail exibido na Política de Privacidade (pedidos de acesso/exclusão de dados)
NEXT_PUBLIC_CONTACT_EMAIL=""

RESERVATION_TIMEOUT_MINUTES=15

# ---------------------------------------------------------------------------
# E-mails de confirmação (opcional — SMTP do Gmail, sem custo e sem domínio próprio)
# Sem estas duas, o app funciona normalmente: só pula o envio do e-mail de cortesia.
# Ver "Configurando os serviços externos" no README para o passo a passo.
# ---------------------------------------------------------------------------
# A conta Gmail que envia (precisa ter verificação em duas etapas ativada, para gerar o app password).
GMAIL_USER=""
# Senha de app de 16 letras gerada em myaccount.google.com/apppasswords — NÃO é a senha normal da conta.
GMAIL_APP_PASSWORD=""
# Nome de exibição do remetente (o endereço visível continua sendo o GMAIL_USER). Padrão: "Momoslist".
EMAIL_FROM_NAME="Momoslist"
